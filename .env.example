# LLM Gateway / OpenAI-Compatible Endpoint
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120
# DeepSeek Flash peak rates. Adjust the three rates and thinking option for other models.
LLM_INPUT_COST_PER_1M_USD=0.30
LLM_CACHED_INPUT_COST_PER_1M_USD=0.006
LLM_OUTPUT_COST_PER_1M_USD=1.20
LLM_THINKING=disabled

# Agent Execution Guardrails
HARNESS_MAX_STEPS=20
HARNESS_MAX_COST_USD=0.15
HARNESS_KEEP_RECENT_OBSERVATIONS=5

# Sandbox Defaults
SANDBOX_BACKEND=local
SANDBOX_DOCKER_IMAGE=python:3.11-slim
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_CORES=2.0
SANDBOX_PIDS_LIMIT=256
SANDBOX_CMD_TIMEOUT=60
